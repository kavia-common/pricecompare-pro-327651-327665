# FastAPI backend configuration for PriceCompare

# Allowed CORS origins (comma-separated). Use "*" to allow all.
# Example:
#   http://localhost:3000,http://localhost:3001
API_CORS_ORIGINS=*

# Optional: override request timeout (seconds) when scraping targets
SCRAPE_TIMEOUT_SECONDS=12

# Optional: override User-Agent used for scraping (some sites block default agents)
SCRAPE_USER_AGENT=PriceCompareBot/1.0 (+https://example.com)

# Database connection variables are provided by the postgres_db container.
# Do not hardcode secrets in code; set these in the runtime environment/.env.
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
